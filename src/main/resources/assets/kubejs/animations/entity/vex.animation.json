{
	"format_version": "1.8.0",
	"animations": {
		"animation.vex.attack.rotations": {
			"loop": true,
			"bones": {
				"body": {
					"rotation": {
						"vector": [0, "variable.attackbodyroty - this", 0]
					}
				},
				"leftArm": {
					"rotation": {
						"vector": ["variable.attackbodyroty", "variable.attackbodyroty", 0]
					}
				},
				"rightArm": {
					"rotation": {
						"vector": [
							"math.sin(1.0 - math.pow(1.0 - variable.attack_time, 3.0) * 180.0) * (variable.is_brandishing_spear ? -1.0 : 1.0 )",
							"(variable.is_brandishing_spear ? 0.0 : variable.attackbodyroty * 2.0) + variable.attackbodyroty",
							0
						]
					}
				}
			}
		},
		"animation.vex.move": {
			"loop": true,
			"anim_time_update": "query.modified_distance_moved",
			"bones": {
				"leftwing": {
					"rotation": {
						"vector": ["27.0 - this", "-(27.0 + math.cos(query.life_time * 916.8) * 9.0) - this", "-27.0 - this"]
					},
					"position": {
						"vector": [0, "-1.0 - this", "2.0 - this"]
					}
				},
				"leg0": {
					"rotation": {
						"vector": ["variable.tcos0 * 1.4 + 36.0", 0, 0]
					}
				},
				"rightArm": {
					"rotation": {
						"vector": ["query.is_charging ? (216.0 - this) : 0.0", 0, 0]
					}
				},
				"rightwing": {
					"rotation": {
						"vector": ["27.0 - this", "27.0 + math.cos(query.life_time * 916.8) * 9.0 - this", "27.0 - this"]
					},
					"position": {
						"vector": [0, "-1.0 - this", "2.0 - this"]
					}
				}
			}
		}
	},
	"geckolib_format_version": 2
}