{
	"format_version": "1.8.0",
	"animations": {
		"animation.npc.baby_transform": {
			"loop": true,
			"bones": {
				"head": {
					"scale": {
						"vector": [1.5, 1.5, 1.5]
					}
				}
			}
		},
		"animation.npc.get_in_bed": {
			"loop": true,
			"bones": {
				"body": {
					"rotation": {
						"vector": [-90, 0, 0]
					},
					"position": {
						"vector": [0, 1, -15]
					}
				}
			}
		},
		"animation.npc.move": {
			"loop": true,
			"anim_time_update": "query.modified_distance_moved",
			"bones": {
				"leg0": {
					"rotation": {
						"vector": ["(math.cos(query.anim_time * 38.17) * 40.0) - this", "-this", 0]
					}
				},
				"leg1": {
					"rotation": {
						"vector": ["(math.cos(query.anim_time * 38.17 + 180) * 40.0) - this", "-this", 0]
					}
				}
			}
		},
		"animation.npc.raise_arms": {
			"loop": true,
			"bones": {
				"arms": {
					"rotation": {
						"vector": ["variable.raise_arms * -15.0", 0, 0]
					}
				}
			}
		}
	},
	"geckolib_format_version": 2
}