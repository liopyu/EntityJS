{
	"format_version": "1.8.0",
	"animations": {
		"animation.parrot.dance": {
			"loop": true,
			"bones": {
				"body": {
					"position": {
						"vector": ["variable.dance.x-this", "variable.dance.y", 0]
					}
				},
				"head": {
					"rotation": {
						"vector": ["-this", "-this", "variable.dance.y*23.0 - this"]
					}
				},
				"leg0": {
					"rotation": {
						"vector": [0, 0, "-20.0 - this"]
					},
					"position": {
						"vector": ["-variable.dance.x", "-variable.dance.y", 0]
					}
				},
				"leg1": {
					"rotation": {
						"vector": [0, 0, "20.0 - this"]
					},
					"position": {
						"vector": ["-variable.dance.x", "-variable.dance.y", 0]
					}
				},
				"tail": {
					"rotation": {
						"vector": ["60.0 - this", 0, 0]
					}
				},
				"wing0": {
					"rotation": {
						"vector": [0, 0, "-5.0 - variable.wing_flap"]
					}
				},
				"wing1": {
					"rotation": {
						"vector": [0, 0, "5.0 + variable.wing_flap"]
					}
				}
			}
		},
		"animation.parrot.flying": {
			"loop": true,
			"bones": {
				"leg0": {
					"rotation": {
						"vector": ["math.cos(query.anim_time * 38.17) * 80.0 * query.modified_move_speed", 0, 0]
					}
				},
				"leg1": {
					"rotation": {
						"vector": ["math.cos(query.anim_time * 38.17) * -80.0 * query.modified_move_speed", 0, 0]
					}
				}
			}
		},
		"animation.parrot.moving": {
			"loop": true,
			"bones": {
				"body": {
					"position": {
						"vector": [0, "variable.wing_flap * 0.3", 0]
					}
				},
				"tail": {
					"rotation": {
						"vector": ["60.0 + math.cos(query.anim_time * 38.17) * 17.0 - this", 0, 0]
					}
				},
				"wing0": {
					"rotation": {
						"vector": [0, 0, "-5.0 - variable.wing_flap * 57.3"]
					}
				},
				"wing1": {
					"rotation": {
						"vector": [0, 0, "5.0 + variable.wing_flap * 57.3"]
					}
				}
			}
		},
		"animation.parrot.sitting": {
			"loop": true,
			"bones": {
				"body": {
					"position": {
						"vector": [0, -1.9, 0]
					}
				},
				"leg0": {
					"rotation": {
						"vector": [90, 0, 0]
					}
				},
				"leg1": {
					"rotation": {
						"vector": [90, 0, 0]
					}
				},
				"tail": {
					"rotation": {
						"vector": ["90.0 - this", 0, 0]
					}
				},
				"wing0": {
					"rotation": {
						"vector": [0, 0, "-5.0-this"]
					}
				},
				"wing1": {
					"rotation": {
						"vector": [0, 0, "5.0-this"]
					}
				}
			}
		},
		"animation.parrot.standing": {
			"loop": true,
			"bones": {
				"leg0": {
					"rotation": {
						"vector": [20, 0, 0]
					}
				},
				"leg1": {
					"rotation": {
						"vector": [20, 0, 0]
					}
				}
			}
		}
	},
	"geckolib_format_version": 2
}