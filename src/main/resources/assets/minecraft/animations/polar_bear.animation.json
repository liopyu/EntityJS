{
	"format_version": "1.8.0",
	"animations": {
		"animation.polar_bear.baby_transform": {
			"loop": true,
			"bones": {
				"head": {
					"position": {
						"vector": [0, -1, 3]
					},
					"scale": {
						"vector": [1.25, 1.25, 1.25]
					}
				}
			}
		},
		"animation.polar_bear.move": {
			"loop": true,
			"bones": {
				"body": {
					"rotation": {
						"vector": ["(-(query.standing_scale) * 63) - this", 0, 0]
					},
					"position": {
						"vector": [0, "-9 - 2 * query.standing_scale - this", 0]
					}
				},
				"leg0": {
					"rotation": {
						"vector": ["query.standing_scale * 63", 0, 0]
					},
					"position": {
						"vector": [0, "-1 * query.standing_scale", "6 * query.standing_scale"]
					}
				},
				"leg1": {
					"rotation": {
						"vector": ["query.standing_scale * 63", 0, 0]
					},
					"position": {
						"vector": [0, "-1 * query.standing_scale", "6 * query.standing_scale"]
					}
				},
				"leg2": {
					"rotation": {
						"vector": ["(query.standing_scale > 1) ? (query.standing_scale * 81) - this : 0", 0, 0]
					}
				},
				"leg3": {
					"rotation": {
						"vector": ["(query.standing_scale > 1) ? (query.standing_scale * 81) - this : 0", 0, 0]
					}
				}
			}
		},
		"animation.polar_bear.walk": {
			"loop": true,
			"anim_time_update": "query.modified_distance_moved",
			"bones": {
				"leg0": {
					"rotation": {
						"vector": ["math.cos(query.anim_time * 38.17) *  80.0", 0, 0]
					}
				},
				"leg1": {
					"rotation": {
						"vector": ["math.cos(query.anim_time * 38.17) * -80.0", 0, 0]
					}
				},
				"leg2": {
					"rotation": {
						"vector": ["math.cos(query.anim_time * 38.17) * -80.0", 0, 0]
					}
				},
				"leg3": {
					"rotation": {
						"vector": ["math.cos(query.anim_time * 38.17) *  80.0", 0, 0]
					}
				}
			}
		}
	},
	"geckolib_format_version": 2
}